<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme (Wingman placeholder, kept) -->
    <style name="Base.Theme.Wingman" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.Wingman" parent="Base.Theme.Wingman" />

    <!-- Base Light Theme (kept but updated background to #212121) -->
    <style name="Base.Theme.AddNotes" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary colors -->
        <item name="colorPrimary">#003060</item>  <!-- background tint for buttons,etc.-->
        <item name="colorOnPrimary">#003060</item> <!-- light icon tint -->
        <item name="colorPrimaryVariant">@android:color/black</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">#003060</item>
        <item name="colorOnSecondary">#c7b57e</item>
        <item name="colorSecondaryVariant">#003060</item>

        <!-- Background and surfaces - CUSTOM DARK GRAY -->
        <item name="android:colorBackground">#FFFFFFFF</item>  <!-- light background -->
        <item name="colorCardBackground">@color/blue</item>  <!-- cards background -->

        <item name="colorSurface">#FFFFFFFF</item> <!-- light surface -->
        <item name="colorOnSurface">#003060</item> <!-- text on surface/cards -->

        <item name="colorSurfaceContainer">#003060</item>


        <item name="colorText">#003060</item>


        <!-- Card style -->
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
    </style>

    <!-- Popup Menus -->
    <style name="ThemeOverlay.App.PopupMenu.White" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupBackground">@android:color/white</item>
    </style>

    <style name="PopupMenuTheme" parent="ThemeOverlay.Material3.Light">
        <item name="android:popupBackground">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>


    <style name="PopupMenu_Light" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Notes Edit Screen -->
    <style name="AppTheme.NotesEdit" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Scheduler Dialog -->
    <style name="ScheduleDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#003060</item>
        <item name="colorSecondary">#003060</item>
        <item name="colorOnSecondary">#c7b57e</item>
    </style>

    <!-- Main Theme -->
    <style name="Theme.AddNotes" parent="Base.Theme.AddNotes" />

</resources>
