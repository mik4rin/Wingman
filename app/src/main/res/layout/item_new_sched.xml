<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:clickable="false"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:background="@drawable/blue_border"
    android:elevation="4dp"
    android:descendantFocusability="afterDescendants"
    android:layout_marginBottom="8dp"
    >

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >

            <TextView
                android:id="@+id/item_sched_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Title"
                android:textColor="@color/blue"
                android:textSize="16sp"
                android:fontFamily="@font/dm_sans_bold"
                android:textStyle="bold"
                android:gravity="start"/>

            <TextView
                android:id="@+id/item_sched_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type"
                android:fontFamily="@font/dm_sans_bold"
                android:textColor="@color/blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>


        <TextView
            android:id="@+id/item_sched_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lorem ipsum dolor sit amet,  sed."
            android:textSize="14sp"
            android:fontFamily="@font/dm_sans_semibold"
            android:textColor="@color/blue"
            android:paddingTop="4dp"/>

        <TextView
            android:id="@+id/item_sched_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On: Jan 01, 2025"
            android:textSize="14sp"
            android:fontFamily="@font/dm_sans_bold"
            android:textColor="@color/gold"
            android:paddingTop="4dp"/>

    </LinearLayout>

</LinearLayout>