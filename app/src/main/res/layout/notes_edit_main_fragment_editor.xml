                        app:cardCornerRadius="17.5dp"
                        app:strokeColor="@color/black"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/card_col_10"
                            android:contentDescription="@string/dummy"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_col11"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="17.5dp"
                        app:strokeColor="@color/black"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/card_col_11"
                            android:contentDescription="@string/dummy"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_col12"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="17.5dp"
                        app:strokeColor="@color/black"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/card_col_12"
                            android:contentDescription="@string/dummy"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_col13"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="17.5dp"
                        app:strokeColor="@color/black"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/card_col_13"
                            android:contentDescription="@string/dummy"/>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/format_buttons_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"

                    >

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_bold"
                        android:text="B"
                        android:textStyle="bold"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="2dp"
                        android:padding="0dp"
                        app:strokeWidth="0dp"
                        android:textSize="18sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_italic"
                        android:text="I"
                        android:textStyle="italic"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="2dp"
                        android:padding="0dp"
                        app:strokeWidth="0dp"
                        android:textSize="18sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_underline"
                        android:text="U"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="2dp"
                        android:padding="0dp"
                        app:strokeWidth="0dp"
                        android:textSize="18sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_h1"
                        android:text="H1"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="2dp"
                        android:padding="0dp"
                        app:strokeWidth="0dp"
                        android:textSize="18sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_strike"
                        android:text="S"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="2dp"
                        android:padding="0dp"
                        app:strokeWidth="0dp"
                        android:textSize="18sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_sub"
                        android:text="ss"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:padding="0dp"
                        app:strokeWidth="0dp"
                        android:textSize="18sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_super"
                        android:text="ss"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:padding="0dp"
                        app:strokeWidth="0dp"
                        android:textSize="18sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_vertical"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_bullet"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:padding="0dp"
                        android:gravity="center"
                        android:text=""
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeWidth="0dp"
                        app:icon="@drawable/text_bulleted_icon"
                        app:iconTint="@color/black"
                        app:iconSize="20dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        android:contentDescription="@string/dummy"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_size"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:padding="0dp"
                        android:gravity="center"
