<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/appbackround"
        android:paddingTop="5dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textSize="16sp"
                android:textColor="@color/blue"
                android:fontFamily="@font/dm_sans_semibold"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/flashcardsCard"
            android:layout_width="300dp"
            android:layout_height="100dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/flashcardIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_add"
                    android:contentDescription="Add Card Icon"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/gold" />

                <TextView
                    android:id="@+id/flashcardsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Flashcard Set"
                    android:textSize="16sp"
                    android:textColor="@color/gold"
                    android:fontFamily="@font/dm_sans_semibold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Empty view -->
        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:text="No flashcard sets yet\nTap above to create one!"
            android:textSize="16sp"
            android:fontFamily="@font/dm_sans_semibold"
            android:textColor="@color/blue"
            android:visibility="gone" />

        <!-- RecyclerView for flashcard sets -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

    </LinearLayout>
</LinearLayout>