<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvCardCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/2"
                android:textSize="13sp"
                android:fontFamily="@font/dm_sans_semibold"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Title"
                android:fontFamily="@font/dm_sans_semibold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Description"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/dm_sans_semibold"
                android:textSize="13sp"
                android:alpha="0.6" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_x"
            android:padding="8dp"
            android:contentDescription="Close"
            app:iconTint="?attr/colorOnSurface" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewWrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toTopOf="@id/navigationSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="3:3.8">

        <FrameLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorCardBackground"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/tvCardLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Question"
                        android:textColor="@color/blue"
                        android:textSize="12sp"
                        android:fontFamily="@font/dm_sans_semibold"
                        android:background="@color/gold"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="7dp" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvCardText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Definition side"
                    android:textColor="@color/gold"
                    android:textSize="19sp"
                    android:fontFamily="@font/dm_sans_semibold"
                    android:textAlignment="center"
                    android:lineSpacingExtra="6dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <View
                        android:layout_width="36dp"
                        android:layout_height="1dp"
                        android:background="@color/gold"
                        android:alpha="0.3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to flip"
                        android:textColor="@color/gold"
                        android:textSize="11sp"
                        android:fontFamily="@font/dm_sans_semibold"
                        android:alpha="0.4"
                        android:layout_marginHorizontal="14dp" />

                    <View
                        android:layout_width="36dp"
                        android:layout_height="1dp"
                        android:background="@color/gold"
                        android:alpha="0.3" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/navigationSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_left"
            android:padding="12dp"
            android:contentDescription="Previous"
            app:tint="?attr/colorSecondary" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/tvCurrentIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/blue"
                android:textSize="20sp"
                android:fontFamily="@font/dm_sans_semibold"
                android:background="@android:color/white"
                android:paddingHorizontal="28dp"
                android:paddingVertical="12dp"
                android:minWidth="64dp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_right"
            android:padding="12dp"
            android:contentDescription="Next"
            app:tint="?attr/colorSecondary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>