<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AddNotes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryVariant">@android:color/black</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <item name="colorSecondary">@android:color/black</item>
        <item name="colorSecondaryVariant">@android:color/black</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorOnSurface">@android:color/white</item>

        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
    </style>

    <!-- a ThemeOverlay just for PopupMenus -->
    <style name="ThemeOverlay.App.PopupMenu.White" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupBackground">@android:color/white</item>
    </style>

    <style name="CustomPopupMenu" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupBackground">#FFFFFF</item> <!-- White background -->
        <item name="android:textColor">#000000</item>       <!-- Black text -->
    </style>

    <style name="PopupMenu_Light" parent="ThemeOverlay.AppCompat.Light">
        <!-- Optional: Customize further if needed -->
    </style>

    <!-- Your main theme -->
    <style name="Theme.AddNotes" parent="Base.Theme.AddNotes" />
</resources>